{
	"name": "pocketlib-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "concurrently \"npm:build:watch\" \"npm:serve:watch\"",
		"dev:email": "email dev --dir src/emails",
		"build": "prisma generate && tsc",
		"build:watch": "tsc -w",
		"serve:watch": "nodemon dist/server.js",
		"generateSitemaps": "tsc && node dist/src/scripts/generateSitemaps.js",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:db:up": "docker compose -f compose.test.yml up -d --wait",
		"test:db:down": "docker compose -f compose.test.yml down",
		"test:db:prepare": "node scripts/prepare-test-database.mjs",
		"test:integration": "npm run test:db:prepare && vitest run --config vitest.integration.config.ts",
		"test:services:up": "docker compose -f compose.test.yml up -d --wait",
		"test:services:down": "docker compose -f compose.test.yml down",
		"test:system": "npm run build && npm run test:db:prepare && vitest run --config vitest.system.config.ts",
		"test:all": "npm run typecheck && npm test && npm run test:integration && npm run test:system"
	},
	"license": "MIT",
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.1134.0",
		"@graphql-tools/schema": "^10.1.1",
		"@graphql-tools/utils": "^12.0.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.1.0",
		"axios": "^1.20.0",
		"blurhash": "^2.0.5",
		"canvas": "^3.2.3",
		"cors": "^2.8.6",
		"dav-js": "github:dav-apps/dav-js#v3.2.3",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"node-html-parser": "^9.0.4",
		"nodemon": "^3.1.14",
		"pdfjs-dist": "^6.3.289",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"redis": "^6.2.1",
		"resend": "^6.28.1",
		"stripe": "^22.6.2",
		"tailwindcss": "^4.3.3",
		"validator": "^13.15.35"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/css-tree": "^3.2.0",
		"@types/express": "^5.0.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/supertest": "^7.2.1",
		"@types/validator": "^13.15.10",
		"@vitest/coverage-v8": "^5.0.1",
		"concurrently": "^10.0.5",
		"nock": "^14.0.17",
		"prisma": "^7.10.0",
		"react-email": "6.9.5",
		"supertest": "^7.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
